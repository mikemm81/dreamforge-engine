# ============================================================================
# 1. Unity (GitHub's Unity.gitignore, CC0-1.0). The project lives in Unity_DF_Alternative/, so
#    the template's root-anchored rules start with /Unity_DF_Alternative.
# ============================================================================
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
# Recommended: add any editor/OS/tool-specific ignore rules from the Global/ templates as needed.
# See: https://github.com/github/gitignore/tree/main/Global
#
.utmp/
/Unity_DF_Alternative/[Ll]ibrary/
/Unity_DF_Alternative/[Tt]emp/
/Unity_DF_Alternative/[Oo]bj/
/Unity_DF_Alternative/[Bb]uild/
/Unity_DF_Alternative/[Bb]uilds/
/Unity_DF_Alternative/[Ll]ogs/
/Unity_DF_Alternative/[Uu]ser[Ss]ettings/
*.log

# Memory Profiler generated files
# MemoryCaptures can get excessive in size
# They also could contain extremely sensitive data
/Unity_DF_Alternative/[Mm]emory[Cc]aptures/

# Recordings can get excessive in size
/Unity_DF_Alternative/[Rr]ecordings/

# Uncomment this line if you wish to ignore the asset store tools plugin
# /Unity_DF_Alternative/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/Unity_DF_Alternative/[Aa]ssets/Plugins/Editor/JetBrains*
# Jetbrains Rider personal-layer settings
*.DotSettings.user

# Visual Studio cache directory
.vs/

# Gradle cache directory
.gradle/

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vsconfig

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
.dirstamp
mono_crash.*
tmpinst-dir.stamp

# Builds
/Unity_DF_Alternative/*_BackUpThisFolder_ButDontShipItWithYourGame/
/Unity_DF_Alternative/*_BurstDebugInformation_DoNotShip/
*.apk
*.aab
*.obb
*.unitypackage
*.unitypackage.meta
*.app

# Crashlytics generated file
crashlytics-build.properties

# Blender generated backup files
/Unity_DF_Alternative/[Aa]ssets/**/*.blend1
/Unity_DF_Alternative/[Aa]ssets/**/*.blend1.meta

# TouchDesigner generated cache files
/Unity_DF_Alternative/[Aa]ssets/**/TDImportCache/
/Unity_DF_Alternative/[Aa]ssets/**/TDImportCache.meta

# Unity Crash Recovery generated files
/Unity_DF_Alternative/[Aa]ssets/_Recovery/
/Unity_DF_Alternative/[Aa]ssets/_Recovery.meta

# Addressables default ignores, before user customizations
# By default, Addressables content builds will generate addressables_content_state.bin
# files in platform-specific subfolders, for example:
# /Assets/AddressableAssetsData/OSX/addressables_content_state.bin
/Unity_DF_Alternative/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin
/Unity_DF_Alternative/[Aa]ssets/AddressableAssetsData/*/addressables_content_state.bin.meta
/Unity_DF_Alternative/[Aa]ssets/AddressableAssetsData/link.xml
/Unity_DF_Alternative/[Aa]ssets/AddressableAssetsData/link.xml.meta
/Unity_DF_Alternative/[Aa]ssets/Addressables_Temp/
/Unity_DF_Alternative/[Aa]ssets/Addressables_Temp.meta
/Unity_DF_Alternative/[Aa]ssets/StreamingAssets/aa/
/Unity_DF_Alternative/[Aa]ssets/StreamingAssets/aa.meta
/Unity_DF_Alternative/ServerData/

# EDM4U generated files
/Unity_DF_Alternative/[Aa]ssets/GeneratedLocalRepo/
/Unity_DF_Alternative/[Aa]ssets/GeneratedLocalRepo.meta

# Android Gradle generated files
/Unity_DF_Alternative/[Aa]ssets/Plugins/Android/**/*.gradle.backup*
/Unity_DF_Alternative/[Aa]ssets/Plugins/Android/**/local.properties

# Test Framework generated files
/Unity_DF_Alternative/[Aa]ssets/Resources/PerformanceTestRunInfo.json
/Unity_DF_Alternative/[Aa]ssets/Resources/PerformanceTestRunInfo.json.meta
/Unity_DF_Alternative/[Aa]ssets/Resources/PerformanceTestRunSettings.json
/Unity_DF_Alternative/[Aa]ssets/Resources/PerformanceTestRunSettings.json.meta
/Unity_DF_Alternative/[Aa]ssets/InitTestScene*.unity
/Unity_DF_Alternative/[Aa]ssets/InitTestScene*.unity.meta

# Visual Scripting auto-generated files
/Unity_DF_Alternative/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers/
/Unity_DF_Alternative/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta
/Unity_DF_Alternative/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/Unity_DF_Alternative/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta

# UI Toolkit auto generated files
/Unity_DF_Alternative/UIElementsSchema/

# Auto-generated cache in Assets folder
/Unity_DF_Alternative/[Aa]ssets/[Ss]ceneDependencyCache*

# Python
__pycache__/
*.py[cod]
.venv/

# Editors and operating systems
.DS_Store
Thumbs.db
.idea/
.vscode/

# ============================================================================
# 2. HARD EXCLUSIONS: game content and anything derived from it.
#    These come last so that nothing above can re-include a match. The only
#    re-include below is the Unity Assets folder itself. Every file rule still
#    applies inside it. Don't add exceptions to make a commit work.
#    Git only ignores UNTRACKED files, and "git add -f" overrides all of this.
# ============================================================================

# --- Folders ---
game/
games/
assets/
# Unity's own folder. Without this, "assets/" hides it where Git ignores case.
